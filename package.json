{
  "name": "oxagent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -c \"blue,green\" -n \"SERVER,CLIENT\" \"tsx watch server/index.ts\" \"vite\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/cleanup.ps1"
  },
  "dependencies": {
    "@ff-labs/fff-node": "^0.10.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/marked": "^5.0.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.25.0",
    "marked": "^18.0.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "uuid": "^11.0.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
