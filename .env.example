# ==============================================================================
# 0xAgent — Environment Configuration Example
# Copy this file to .env and adjust values according to your environment.
# ==============================================================================

# --- Server & Network Settings ---
PORT=3001
HOST=0.0.0.0


# Groq Cloud API Key (Optional)
GROQ_API_KEY=your_groq_api_key_here

# --- Local SearXNG Web Search Engine ---
# Docker instance URL for privacy-preserving web search (defaults to http://localhost:8080)
SEARXNG_URL=http://localhost:8080

# --- Local llama.cpp Server (Optional overrides) ---
# LLAMA_SERVER_PATH=~/.0xagent/llama/llama-server.exe
# DEFAULT_MODEL_PATH=~/.0xagent/models/model.gguf

# --- Security & Access Control ---
# Optional master password to protect API endpoints and WebSocket access
# AUTH_PASSWORD=your_secure_master_password
